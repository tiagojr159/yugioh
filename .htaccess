Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|bin|scripts|voice|vendor|node_modules|\.tools|\.cache|\.git)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:composer\.(?:json|lock)|package(?:-lock)?\.json|README\.md)$ - [F,L,NC]
RewriteRule ^(assets|markers|uploads)/(.*)$ public/$1/$2 [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

AddType text/javascript .js .mjs
AddType application/wasm .wasm
AddType model/gltf-binary .glb
AddType application/octet-stream .patt .dat
